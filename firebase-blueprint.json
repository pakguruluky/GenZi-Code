{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "User profile and progress in GenZi Code platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "instruktur", "siswa", "trial"] },
        "status": { "type": "string", "enum": ["active", "pending", "rejected"] },
        "registeredAt": { "type": "string" },
        "approvedAt": { "type": "string" },
        "approvedBy": { "type": "string" },
        "duration": { "type": "string" },
        "completedMaterialIds": { "type": "array" },
        "school": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "quizScore": { "type": "number" },
        "quizCount": { "type": "number" },
        "xp": { "type": "number" },
        "badges": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "role", "status"]
    },
    "StudioProject": {
      "title": "StudioProject",
      "description": "Saved user project in Coding Studios",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studioType": { "type": "string", "enum": ["scratch", "pictoblox", "microbit"] },
        "title": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "studioType", "title"]
    },
    "OnlineClassSchedule": {
      "title": "OnlineClassSchedule",
      "description": "Scheduled online live tutoring classes via Zoom or Google Meet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "platform": { "type": "string", "enum": ["zoom", "gmeet"] },
        "meetingUrl": { "type": "string" },
        "meetingId": { "type": "string" },
        "passcode": { "type": "string" },
        "instructorName": { "type": "string" },
        "dateTime": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "targetAudience": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "ongoing", "completed", "cancelled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "platform", "meetingUrl", "instructorName", "dateTime", "durationMinutes", "status"]
    },
    "QuizSubmission": {
      "title": "QuizSubmission",
      "description": "Post-test submissions recorded for each student and material",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "materialId": { "type": "string" },
        "materialTitle": { "type": "string" },
        "category": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "correctCount": { "type": "number" },
        "passed": { "type": "boolean" },
        "xpEarned": { "type": "number" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "userId", "materialId", "score", "passed"]
    },
    "JenjangCertificate": {
      "title": "JenjangCertificate",
      "description": "Official graduation certificate issued upon completing all materials in a jenjang",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "certificateNumber": { "type": "string" },
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "school": { "type": "string" },
        "jenjangId": { "type": "string" },
        "jenjangTitle": { "type": "string" },
        "jenjangCode": { "type": "string" },
        "competencyList": { "type": "array" },
        "totalMaterials": { "type": "number" },
        "completedMaterials": { "type": "number" },
        "averageQuizScore": { "type": "number" },
        "xpEarned": { "type": "number" },
        "issuedAt": { "type": "string" },
        "instructorName": { "type": "string" },
        "instructorTitle": { "type": "string" },
        "verificationCode": { "type": "string" },
        "verificationUrl": { "type": "string" }
      },
      "required": ["id", "certificateNumber", "userId", "studentName", "jenjangId", "jenjangTitle", "issuedAt"]
    }
  },
  "firestore": {
    "/genzi_users/{userId}": {
      "schema": "UserAccount",
      "description": "Registered students, instructors, and admin accounts"
    },
    "/genzi_projects/{projectId}": {
      "schema": "StudioProject",
      "description": "User created projects from Scratch, PictoBlox, and Microbit studios"
    },
    "/genzi_online_classes/{classId}": {
      "schema": "OnlineClassSchedule",
      "description": "Online live class schedules"
    },
    "/genzi_quiz_submissions/{submissionId}": {
      "schema": "QuizSubmission",
      "description": "Historical records of student post-test attempts and results"
    },
    "/genzi_certificates/{certificateId}": {
      "schema": "JenjangCertificate",
      "description": "Official verifiable completion certificates issued for each jenjang"
    }
  }
}
